rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - photoURL: string
    //   - role: string (user/admin)
    //   - createdAt: timestamp
    //
    // Collection: bookmarks
    // Document ID: {userId}_{mangaId}
    // Fields:
    //   - userId: string (required)
    //   - mangaId: string (required)
    //   - title: string
    //   - coverUrl: string
    //   - addedAt: timestamp
    //
    // Collection: progress
    // Document ID: {userId}_{mangaId}
    // Fields:
    //   - userId: string (required)
    //   - mangaId: string (required)
    //   - lastChapterId: string
    //   - lastChapterNumber: string
    //   - updatedAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "hiltonjolly@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             (!('role' in data) || data.role == 'user'); // Users can't make themselves admins
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['userId', 'mangaId']) &&
             data.userId == request.auth.uid &&
             data.mangaId is string;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'mangaId']) &&
             data.userId == request.auth.uid &&
             data.mangaId is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    request.resource.data.role == resource.data.role; // Role is immutable for users
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidBookmark(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidBookmark(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /progress/{progressId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidProgress(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidProgress(request.resource.data);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['mangaId', 'userId', 'text', 'createdAt']) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() > 0 &&
                    request.resource.data.text.size() < 1000;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /search_cache/{mangaDexId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }
  }
}
